# Postgres
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/monitor_energia

# Firebase (conta de serviço — nunca commitar o JSON real)
# Local: use o arquivo via FIREBASE_SERVICE_ACCOUNT_PATH.
# Produção (Render etc., sem filesystem persistente pra secrets): cole o
# conteúdo do JSON inteiro em FIREBASE_SERVICE_ACCOUNT_JSON (tem prioridade
# sobre o PATH quando preenchido).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com

# Domínios extras liberados no CORS, separados por vírgula (localhost já é
# sempre liberado). Em produção, coloque a URL do frontend publicado:
# CORS_ALLOWED_ORIGINS=https://monitor-energia-xxxx.web.app
CORS_ALLOWED_ORIGINS=

# Tarifa usada para calcular o custo estimado (R$/kWh)
TARIFF_RATE_BRL_PER_KWH=0.75

# Bandeira tarifária vigente: green | yellow | red1 | red2
TARIFF_FLAG=green

# Intensidade de carbono da rede elétrica (kg CO2/kWh)
CARBON_INTENSITY_KG_PER_KWH=0.08

# Detecção de standby: potência (W) e duração mínima (min) para contar como standby
STANDBY_THRESHOLD_W=15
STANDBY_MIN_MINUTES=30
